# Força HTTPS em todo o site e envia HSTS nas respostas.
# Cobre tanto Apache terminando TLS diretamente (%{HTTPS}) quanto um proxy
# na frente que só repassa X-Forwarded-Proto — cPanel/Hostgator pode usar
# qualquer um dos dois dependendo do plano, então checamos os dois.
# /.well-known/ fica de fora para não atrapalhar a validação do AutoSSL
# (este arquivo substitui o .htaccess do servidor a cada deploy, então as
# exceções que o cPanel costuma inserir sozinho não sobrevivem).
RewriteEngine On

# URL antiga do formulário → /pre-agendamento/. Vem antes do redirect de
# HTTPS e já aponta para https e para a forma com barra (ver abaixo), para ser
# um único 301. Cobre com e sem barra final e o .html. Preserva a query string.
RewriteRule ^pre-atendimento(?:/|\.html)?$ https://%{HTTP_HOST}/pre-agendamento/ [L,R=301]

RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# O export estático gera <rota>.html e também uma pasta <rota>/ (só com os
# .txt do Next, sem index.html). O Apache redireciona /rota para /rota/ (por
# causa da pasta) e respondia 403 ali. Esta regra serve <rota>.html em /rota/.
# Sem DirectorySlash Off de propósito: exigiria AllowOverride Indexes, e se o
# host não permitir o site inteiro dá 500. Testado em Apache 2.4 (httpd:2.4).
RewriteCond %{REQUEST_FILENAME} ^(.+)/$
RewriteCond %1.html -f
RewriteRule ^(.+)/$ $1.html [L]

# HSTS: começa conservador (5 min), sem includeSubDomains e sem preload.
# Depois de confirmar http→https em produção, subir para max-age=31536000.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=300"
</IfModule>
