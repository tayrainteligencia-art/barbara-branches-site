# URL pública do site (usada em metadata, Open Graph e dados estruturados)
NEXT_PUBLIC_SITE_URL=

# Link de mensagem do WhatsApp da clínica (wa.me/message/<código>).
# Padrão já confirmado no código (src/lib/whatsapp.ts); defina aqui só para sobrescrever.
NEXT_PUBLIC_WHATSAPP_LINK=

# Mensagem pré-preenchida do botão de WhatsApp
NEXT_PUBLIC_WHATSAPP_MESSAGE="Olá! Gostaria de agendar uma avaliação."

# Serviço de envio do formulário de contato (Resend — https://resend.com).
# Sem essas variáveis, o formulário exibe uma mensagem orientando o
# visitante a usar o WhatsApp em vez de tentar enviar e-mail.
RESEND_API_KEY=
# Endereço verificado no Resend para o campo "from" do e-mail
CONTACT_EMAIL_FROM=
# Para onde o e-mail do formulário de contato é enviado
CONTACT_EMAIL_TO=
